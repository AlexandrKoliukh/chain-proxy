{% set is_entry = inventory_hostname in groups['entry'] %}
{% set self_addr = wg_entry_addr if is_entry else wg_exit_addr %}
[Interface]
Address = {{ self_addr }}/30
ListenPort = {{ wg_listen_port }}
PrivateKey = {{ wg_private_key }}
MTU = {{ wg_mtu }}
{% if is_entry %}
# VPS1: routes for marked traffic are managed manually via PostUp below.
# `Table = off` prevents wg-quick from auto-installing a default route
# (which would otherwise be triggered by AllowedIPs=0.0.0.0/0 and break SSH).
Table = off
PostUp = ip rule add fwmark {{ wg_fwmark }} lookup {{ wg_route_table }} priority 100 2>/dev/null || true
PostUp = ip route replace default dev %i table {{ wg_route_table }}
PostDown = ip rule del fwmark {{ wg_fwmark }} lookup {{ wg_route_table }} priority 100 2>/dev/null || true
PostDown = ip route flush table {{ wg_route_table }} 2>/dev/null || true
{% else %}
# VPS2: NAT traffic arriving from the WG subnet out to the public interface.
# `-I FORWARD 1` (insert at the top) is critical when Docker is installed:
# Docker prepends its DOCKER-USER / DOCKER-FORWARD chains and silently drops
# non-Docker forwarded traffic before any later -A rule can match.
PostUp = sysctl -q -w net.ipv4.ip_forward=1
PostUp = iptables -I FORWARD 1 -i %i -j ACCEPT
PostUp = iptables -I FORWARD 1 -o %i -j ACCEPT
PostUp = iptables -t nat -A POSTROUTING -s {{ wg_subnet }} -o {{ ansible_default_ipv4.interface }} -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -j ACCEPT 2>/dev/null || true
PostDown = iptables -D FORWARD -o %i -j ACCEPT 2>/dev/null || true
PostDown = iptables -t nat -D POSTROUTING -s {{ wg_subnet }} -o {{ ansible_default_ipv4.interface }} -j MASQUERADE 2>/dev/null || true
{% endif %}

[Peer]
PublicKey = {{ wg_peer_public_key }}
{% if is_entry %}
# VPS2 peer: WireGuard cryptokey-routing must accept arbitrary destinations
# (anything Xray sends via wg0 with sockopt.mark) and arbitrary reply sources.
AllowedIPs = 0.0.0.0/0
Endpoint = {{ wg_peer_endpoint }}
PersistentKeepalive = 25
{% else %}
# VPS1 peer: only packets sourced from the WG tunnel addr are accepted/sent.
AllowedIPs = {{ wg_entry_addr }}/32
{% endif %}
