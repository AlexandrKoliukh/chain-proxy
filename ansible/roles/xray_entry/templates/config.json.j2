{
  "log": {
    "loglevel": "warning"
  },

  "inbounds": [
    {
      "tag": "vless-reality-in",
      "listen": "0.0.0.0",
      "port": {{ entry_listen_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ entry_client_uuid }}",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ reality_dest_host }}:{{ reality_dest_port }}",
          "xver": 0,
          "serverNames": ["{{ reality_dest_host }}"],
          "privateKey": "{{ entry_private_key }}",
          "shortIds": ["{{ entry_short_id }}"]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
    }
  ],

  "outbounds": [
    {
      "tag": "chain-proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "{{ exit_address }}",
            "port": {{ exit_port }},
            "users": [
              {
                "id": "{{ link_uuid }}",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "{{ reality_dest_host }}",
          "fingerprint": "{{ reality_fingerprint }}",
          "publicKey": "{{ link_public_key }}",
          "shortId":   "{{ link_short_id }}",
          "spiderX":   "/"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": { "domainStrategy": "UseIP" }
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],

  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "ip": ["geoip:ru"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": ["geosite:category-ru"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "chain-proxy"
      }
    ]
  }
}
