{
  "log": {
    "loglevel": "{{ xray_loglevel | default('warning') }}",
    "access": "{{ xray_log_dir }}/access.log",
    "error": "{{ xray_log_dir }}/error.log"
  },

  "dns": {
    "servers": [
      {
        "address": "77.88.8.8",
        "port": 53,
        "domains": [
          "geosite:category-ru",
          "geosite:yandex",
          "geosite:vk",
          "geosite:mailru",
          "domain:kinopoisk.ru",
          "domain:kinopoisk-ott.ru",
          "domain:yandex.ru",
          "domain:yandex.net",
          "domain:vk.com"
        ]
      },
      {
        "address": "https+local://1.1.1.1/dns-query",
        "port": 443
      }
    ],
    "queryStrategy": "UseIP",
    "disableCache": false
  },

  "inbounds": [
    {
      "tag": "vless-reality-in",
      "listen": "0.0.0.0",
      "port": {{ entry_listen_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
{% for c in entry_clients %}
          {
            "id": "{{ c.id }}",
            "email": "{{ c.email }}",
            "flow": "xtls-rprx-vision"
          }{% if not loop.last %},{% endif %}

{% endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ reality_dest_host }}:{{ reality_dest_port }}",
          "xver": 0,
          "serverNames": ["{{ reality_dest_host }}"],
          "privateKey": "{{ entry_private_key }}",
          "shortIds": ["{{ entry_short_id }}"]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
    }
  ],

  "outbounds": [
    {
      "tag": "chain-proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "{{ exit_address }}",
            "port": {{ exit_port }},
            "users": [
              {
                "id": "{{ link_uuid }}",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "{{ reality_dest_host }}",
          "fingerprint": "{{ reality_fingerprint }}",
          "publicKey": "{{ link_public_key }}",
          "shortId":   "{{ link_short_id }}",
          "spiderX":   "/"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": { "domainStrategy": "UseIP" }
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],

  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "domain": [
          "geosite:category-ru",
          "geosite:yandex",
          "geosite:vk",
          "geosite:mailru"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": ["geoip:ru"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "chain-proxy"
      }
    ]
  }
}
