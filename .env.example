# Скопируйте этот файл в .env и впишите IP-адреса ваших VPS.
#   cp .env.example .env
#
# Этот файл автоматически подхватывается Makefile-ом.
# Все переменные улетают в окружение — ansible читает их через lookup('env').

# ─── IP серверов (заполните руками) ─────────────────────────────
IP_VPS1=1.2.3.4 # Домашний, входной сервер
IP_VPS2=5.6.7.8 # Зарубежный, выходной сервер

# ─── Ключи и UUID (НЕ заполняйте вручную) ───────────────────────
# После `make gen-keys` в конец .env допишется блок между маркерами:
#   # === chain-proxy keys (auto-generated by make gen-keys; do not edit) ===
#   ENTRY_CLIENT_UUID=...    # admin
#   ENTRY_FRIENDS_UUID=...   # для друзей (общий UUID)
#   ENTRY_PRIVATE_KEY=...
#   ENTRY_PUBLIC_KEY=...
#   ENTRY_SHORT_ID=...
#   LINK_UUID=...               # legacy, оставлен на случай отката на Reality
#   LINK_PUBLIC_KEY=...
#   LINK_PRIVATE_KEY=...
#   LINK_SHORT_ID=...
#   WG_VPS1_PRIVATE=...         # WireGuard для inter-VPS туннеля (VPS1)
#   WG_VPS1_PUBLIC=...
#   WG_VPS2_PRIVATE=...         # WireGuard для inter-VPS туннеля (VPS2)
#   WG_VPS2_PUBLIC=...
#   # === end chain-proxy keys ===
# Повторный запуск `make gen-keys` перегенерирует блок.
